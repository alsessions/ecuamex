<!DOCTYPE html>
<html lang="en-US">
{% include '_partials/_header.twig' %}
<body class="bg-gradient-to-br from-green-200 via-yellow-200 to-red-200 min-h-screen">
    {% include '_partials/_nav.twig' %}
    <header class="bg-gradient-to-r from-green-600 via-yellow-500 to-red-600 pt-8 pb-12 md:pt-12 md:pb-20 mb-8 md:mb-12">
        <div class="container mx-auto px-4 text-center">
            <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold text-white mb-4 drop-shadow-lg">ECUAMEX</h1>
            <p class="text-2xl md:text-3xl lg:text-4xl text-white font-bold mb-2 drop-shadow-md">Deli Restaurant</p>
            <p class="text-xl md:text-2xl text-white/90 drop-shadow">Authentic Ecuadorian & Mexican Cuisine</p>
        </div>
    </header>

    <div class="container mx-auto px-4 py-8">
        <div class="max-w-5xl mx-auto">

            <div class="bg-white rounded-xl shadow-lg p-6 md:p-8 mb-8 text-gray-800 prose prose-md max-w-none">
                {% if entry.body is defined %}
                    <div class="prose max-w-none mb-8">
                        {{ entry.body }}
                    </div>
                {% endif %}

                <form method="post" accept-charset="UTF-8">
                    {{ csrfInput() }}
                    {{ actionInput('contact-form/send') }}

                    {% if message is defined %}
                        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
                            {{ message }}
                        </div>
                    {% endif %}

                    <div class="space-y-6">
                        <div>
                            <label for="fromName" class="block text-sm font-medium text-gray-700 mb-2">Name</label>
                            <input type="text" id="fromName" name="fromName" value="{{ message.fromName ?? '' }}" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent">
                        </div>

                        <div>
                            <label for="fromEmail" class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                            <input type="email" id="fromEmail" name="fromEmail" value="{{ message.fromEmail ?? '' }}" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent">
                        </div>

                        <div>
                            <label for="subject" class="block text-sm font-medium text-gray-700 mb-2">Subject</label>
                            <input type="text" id="subject" name="subject" value="{{ message.subject ?? '' }}" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent">
                        </div>

                        <div>
                            <label for="message" class="block text-sm font-medium text-gray-700 mb-2">Message</label>
                            <textarea id="message" name="message[body]" rows="6" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent">{{ message.message.body ?? '' }}</textarea>
                        </div>

                        <div>
                            <button type="submit" class="w-full bg-gradient-to-r from-green-600 to-yellow-500 text-white font-bold py-3 px-6 rounded-lg hover:from-green-700 hover:to-yellow-600 transition duration-200">Send Message</button>
                        </div>
                    </div>
                </form>
            </div>

            {% include '_partials/_footer.twig' %}
        </div>
    </div>
</body>
</html>
