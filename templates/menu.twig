                            <div class="text-sm text-gray-600">Grilled Steak</div>
                        </div>
                        <div>
                            <div class="flex justify-between"><span class="font-semibold">GUATITA</span><span class="text-green-600 font-bold">$15.00</span></div>
                            <div class="text-sm text-gray-600">Grilled Steak with onions</div>
                        </div>
                        <div>
                            <div class="flex justify-between"><span class="font-semibold">SALCHIPAPAS</span><span class="text-green-600 font-bold">$7.00</span></div>
                            <div class="text-sm text-gray-600">Fried hot dog & french fries</div>
                        </div>
                        <div>
                            <div class="flex justify-between"><span class="font-semibold">CEVICHE</span><span class="text-green-600 font-bold">$18.00</span></div>
                            <div class="text-sm text-gray-600">Shrimp Cocktail</div>
                        </div>
                        <div>
                            <div class="flex justify-between"><span class="font-semibold">PECHUGA O BISTEC APANADO</span><span class="text-green-600 font-bold">$16.00</span></div>
                            <div class="text-sm text-gray-600">Breaded Beef or Chicken Breast</div>
                        </div>
                        <div>
                            <div class="flex justify-between"><span class="font-semibold">FRITADA CON MOTE</span><span class="text-green-600 font-bold">$17.00</span></div>
