<!DOCTYPE html>
<html lang="en-US">
{% include '_partials/_header.twig' %}
<body class="bg-gradient-to-br from-green-200 via-yellow-200 to-red-200 min-h-screen">
    {% include '_partials/_nav.twig' %}
    <header class="bg-gradient-to-r from-green-600 via-yellow-500 to-red-600 pt-8 pb-12 md:pt-12 md:pb-20 mb-8 md:mb-12">
        <div class="container mx-auto px-4 text-center">
            <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold text-white mb-4 drop-shadow-lg">ECUAMEX</h1>
            <p class="text-2xl md:text-3xl lg:text-4xl text-white font-bold mb-2 drop-shadow-md">Deli Restaurant</p>
            <p class="text-xl md:text-2xl text-white/90 drop-shadow">Authentic Ecuadorian & Mexican Cuisine</p>
        </div>
    </header>

    <div class="container mx-auto px-4 py-8">
        <div class="max-w-5xl mx-auto">

            <div class="bg-white rounded-xl shadow-lg p-6 md:p-8 mb-8 text-gray-800">

                {# CRAFT CMS MENU STRUCTURE #}
                {% set menuEntries = craft.entries().section('mainMenu').type('menu').all() %}
                {% for entry in menuEntries %}
                    <section class="mb-12">
                        <h2 class="text-3xl md:text-4xl font-bold text-red-600 mb-6 border-b-4 border-yellow-400 pb-2">{{ entry.title|upper }}</h2>
                        <div class="grid md:grid-cols-2 gap-6">
                            {# Matrix field - menuItem blocks #}
                            {% for block in entry.menuItem.all() %}
                                <div>
                                    <div class="flex justify-between"><span class="font-semibold">{{ block.title|upper }}</span><span class="text-green-600 font-bold">{{ block.price|money }}</span></div>
                                    {% if block.body %}
                                        <div class="text-sm text-gray-600">{{ block.body }}</div>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </section>
                {% endfor %}
                {# END CRAFT CMS MENU STRUCTURE #}

                <hr class="my-12 border-t-2 border-gray-300">
                <div class="mx-auto">
                <p>Real menu above.</p>
                </div>
                <hr class="my-12 border-t-2 border-gray-300">

                {# HARDCODED MENU BELOW - TO BE REPLACED #}

