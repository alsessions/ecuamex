<!DOCTYPE html>
<html lang="en-US">
{% include '_partials/_header.twig' %}
<body class="bg-gradient-to-br from-green-200 via-yellow-200 to-red-200 min-h-screen">
    {% include '_partials/_nav.twig' %}
    <header class="bg-gradient-to-r from-green-600 via-yellow-500 to-red-600 pt-8 pb-12 md:pt-12 md:pb-20 mb-8 md:mb-12">
        <div class="container mx-auto px-4 text-center">
            <h1 class="font-heading text-5xl md:text-7xl lg:text-8xl font-bold text-white mb-4 drop-shadow-lg">ECUAMEX</h1>
            <p class="text-2xl md:text-3xl lg:text-4xl text-white font-bold mb-2 drop-shadow-md">Deli Restaurant</p>
            <p class="text-xl md:text-2xl text-white/90 drop-shadow">Authentic Ecuadorian & Mexican Cuisine</p>
        </div>
    </header>

    <div class="container mx-auto px-4 py-8">
        <div class="max-w-5xl mx-auto">

            <div class="bg-gradient-to-br from-red-600 to-red-700 rounded-xl shadow-lg p-6 mb-8 text-white">
                <div class="text-center mb-4">
                    <div class="inline-flex items-center justify-center w-12 h-12 bg-white rounded-full mb-3">
                        <span class="text-2xl font-bold text-red-600">☎</span>
                    </div>
                    <h2 class="text-2xl md:text-3xl font-bold mb-1">Order Now</h2>
                    <p class="text-red-100 text-sm mb-4">Call us for delivery or pickup</p>
                </div>

                <div class="text-center space-y-3">
                    <a href="tel:3157350243" class="block">
                        <div class="text-3xl md:text-4xl font-bold hover:scale-105 transition-transform">315.735.0243</div>
                    </a>

                    <div class="border-t border-red-400 pt-4 mt-4">

                        <a href="https://maps.google.com/?q=1207+Bleecker+St+Utica+NY" target="_blank" class="text-lg md:text-xl font-bold hover:text-yellow-300 transition-colors">
                            1207 Bleecker St, Utica, NY
                        </a>
                    </div>

                    <div class="bg-red-800/50 rounded-lg p-3 mt-4">
                        <div class="flex items-center justify-center">
                            <span class="text-red-100 text-sm font-medium">🚗 HACEMOS DELIVERY • TAX NOT INCLUDED</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid md:grid-cols-2 gap-6 mb-8">
                <div class="bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition-shadow border-t-4 border-green-500">
                    <div class="flex items-center mb-4">
                        <div class="w-12 h-12 bg-green-500 rounded-lg flex items-center justify-center mr-3">
                            <span class="text-white text-lg font-bold">EC</span>
                        </div>
                        <h2 class="text-2xl font-bold text-gray-800">Especialidades Ecuatorianas</h2>
                    </div>
                    <ul class="space-y-2 text-gray-700">
                        <li class="flex items-start">
                            <span class="text-green-600 mr-2">•</span>
                            <span><strong>Ceviche</strong> - Fresh shrimp cocktail</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-green-600 mr-2">•</span>
                            <span><strong>Encebollado</strong> - Tuna soup with pickled onions</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-green-600 mr-2">•</span>
                            <span><strong>Seco de Pollo/Carne</strong> - Braised chicken or beef</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-green-600 mr-2">•</span>
                            <span><strong>Fritada con Mote</strong> - Fried pork with hominy</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-green-600 mr-2">•</span>
                            <span><strong>Chaulafan</strong> - Ecuadorian fried rice</span>
                        </li>
                    </ul>
                </div>

                <div class="bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition-shadow border-t-4 border-red-500">
                    <div class="flex items-center mb-4">
                        <div class="w-12 h-12 bg-red-500 rounded-lg flex items-center justify-center mr-3">
                            <span class="text-white text-lg font-bold">MX</span>
                        </div>
                        <h2 class="text-2xl font-bold text-gray-800">Platillos Mexicanos</h2>
                    </div>
                    <ul class="space-y-2 text-gray-700">
                        <li class="flex items-start">
                            <span class="text-red-600 mr-2">•</span>
                            <span><strong>Enchiladas</strong> - Verde or mole sauce</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-red-600 mr-2">•</span>
                            <span><strong>Flautas</strong> - Crispy rolled tacos</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-red-600 mr-2">•</span>
                            <span><strong>Mole Poblano</strong> - Chicken in traditional mole sauce</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-red-600 mr-2">•</span>
                            <span><strong>Tacos & Quesadillas</strong> - Your choice of meat</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-red-600 mr-2">•</span>
                            <span><strong>Burritos & Tortas</strong> - Authentic Mexican style</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-lg p-6 md:p-8 mb-8">
                <div class="flex items-center justify-center mb-6">
                    <div class="w-12 h-12 bg-yellow-500 rounded-lg flex items-center justify-center mr-3">
                        <span class="text-white text-2xl font-bold">☕</span>
                    </div>
                    <h2 class="text-2xl md:text-3xl font-bold text-gray-800">Daily Soups (Sopas)</h2>
                </div>
                <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
                    <div class="bg-yellow-50 rounded-lg p-4 border border-yellow-200">
                        <div class="font-bold text-gray-800 mb-1">Lunes (Monday)</div>
                        <div class="text-gray-700">Caldo de Gallina</div>
                        <div class="text-sm text-gray-600">Hen soup</div>
                    </div>
                    <div class="bg-yellow-50 rounded-lg p-4 border border-yellow-200">
                        <div class="font-bold text-gray-800 mb-1">Martes (Tuesday)</div>
                        <div class="text-gray-700">Caldo de Pata</div>
                        <div class="text-sm text-gray-600">Cow feet soup</div>
                    </div>
                    <div class="bg-yellow-50 rounded-lg p-4 border border-yellow-200">
                        <div class="font-bold text-gray-800 mb-1">Miércoles (Wednesday)</div>
                        <div class="text-gray-700">Pozole</div>
                        <div class="text-sm text-gray-600">Hominy soup w/pork</div>
                    </div>
                    <div class="bg-yellow-50 rounded-lg p-4 border border-yellow-200">
                        <div class="font-bold text-gray-800 mb-1">Jueves (Thursday)</div>
                        <div class="text-gray-700">Caldo de Res & Aguadito</div>
                        <div class="text-sm text-gray-600">Beef & chicken soup</div>
                    </div>
                    <div class="bg-yellow-50 rounded-lg p-4 border border-yellow-200">
                        <div class="font-bold text-gray-800 mb-1">Viernes (Friday)</div>
                        <div class="text-gray-700">Pancit & Encebollado</div>
                        <div class="text-sm text-gray-600">Tripe & tuna soup</div>
                    </div>
                    <div class="bg-yellow-50 rounded-lg p-4 border border-yellow-200">
                        <div class="font-bold text-gray-800 mb-1">Sábado (Saturday)</div>
                        <div class="text-gray-700">Caldo de Mariscos</div>
                        <div class="text-sm text-gray-600">Seafood soup</div>
                    </div>
                </div>
            </div>

            <div class="grid md:grid-cols-2 gap-6 mb-8">
                <div class="bg-gradient-to-br from-orange-500 to-orange-600 rounded-xl shadow-lg p-6 text-white">
                    <h3 class="text-2xl font-bold mb-4">☀ Desayuno / Breakfast</h3>
                    <ul class="space-y-2">
                        <li>• Huevos a la Mexicana</li>
                        <li>• Mote Pillo (Ecuadorian eggs)</li>
                        <li>• Chilaquiles Verdes</li>
                        <li>• Eggs on a Roll</li>
                        <li>• Llapingacho con Huevos</li>
                    </ul>
                </div>

                <div class="bg-gradient-to-br from-yellow-500 to-yellow-600 rounded-xl shadow-lg p-6 text-white">
                    <h3 class="text-2xl font-bold mb-4">★ Antojitos Mexicanos</h3>
                    <ul class="space-y-2">
                        <li>• Tostadas</li>
                        <li>• Quesadillas</li>
                        <li>• Huarache</li>
                        <li>• Burritos</li>
                        <li>• Tortas & Nachos</li>
                    </ul>
                </div>
            </div>

            {% include '_partials/_footer.twig' %}
        </div>
    </div>
</body>
</html>
